# Copy to .env and adjust as needed. No secrets required — this app has no
# external database or auth backend (SQLite file + simulated demo data).

# --- optional (defaults shown) ---
STACK_NAME=ibvap
DATA_ROOT=./ibvap/data
APP_UID=1000
BACKEND_PORT=8000
FRONTEND_PORT=10028
BIND_ADDRESS=0.0.0.0
CORS_ORIGINS=["http://localhost:10028","http://localhost:5173"]
SIMULATION_MODE=true
